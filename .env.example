# Run bash scripts/setup.sh as an ordinary user to choose a password and install mode.
DASHBOARD_PASSWORD=replace-with-a-long-random-password
# Set to 1 only if HTTPS is provided by a trusted local reverse proxy.
DASHBOARD_COOKIE_SECURE=0
# Optional: defaults to <project>/data. If changed, also update the user unit's
# ReadWritePaths to permit writing to the new directory.
# DASHBOARD_DATA_DIR=/absolute/path/to/private/dashboard-data

# Written by setup; used by the generated systemd unit.
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=8765
DASHBOARD_INSTALL_MODE=user
